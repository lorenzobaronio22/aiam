# Copy to `.env` and adjust. Every value is optional; the zod schema in
# src/env.ts defines the defaults and validates anything you set.
NODE_ENV=development
PORT=8787
# Comma-separated list. Empty means same-origin only (the Vite dev proxy).
CORS_ORIGINS=
# Directory of the built SPA to serve from this process. Empty (the default)
# disables static serving — in development Vite serves the frontend.
STATIC_ROOT=
